
# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# SQLite Database (Async aiosqlite engine)
DATABASE_URL=sqlite+aiosqlite:///./kiteshield.db

# Cryptographic Token Signing Secret (JWT HS256)
# MUST be at least 64 hex characters (32 bytes / 256 bits).
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CAPABILITY_TOKEN_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# Backend role authentication
# Generate a new Proposer key in your terminal:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste the generated value into the existing API_KEY entry in backend/.env.
# Restart the normal backend, then connect as Proposer using only the key value.
# Generating a key does not register it automatically.
#
# Isolated invoice demo exception:
# tmp/invoice-demo-server.py ignores .env and configures public fixture keys.
# Its Proposer key is invoice-lab-proposer-fixture; no generation is needed.
# Editing API_KEY in .env does not change that isolated demo's credential.
# Never use this public fixture key in a normal or funded-wallet profile.
# Configure these in backend/.env, never VITE_* variables or committed files.
# The dashboard sends the selected role's key in the X-API-Key header.
# Each key MUST be different: the proposer cannot approve or administer policies.
# API_KEY: Proposer — create, evaluate, and submit authorized proposals.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_32

# APPROVER_API_KEY: Human approver — approve or reject transaction approval requests.
# POLICY_ADMIN_API_KEY: Policy administrator — create/update security policies.
# Leave blank to disable that role. Generate TWO independent values from backend/:
#   ./.venv/bin/python -c 'import secrets; print("APPROVER_API_KEY=" + secrets.token_urlsafe(32)); print("POLICY_ADMIN_API_KEY=" + secrets.token_urlsafe(32))'
# Copy each generated value to its matching existing entry in backend/.env.
# Do not duplicate entries or replace a working key unnecessarily.
APPROVER_API_KEY=
POLICY_ADMIN_API_KEY=
# Optional demo credential. This grants combined permissions ONLY in the isolated
# .env.demo simulation profile, never against this live/default profile.
DEMO_ADMIN_API_KEY=
# Restart the existing backend after editing .env; settings are cached at startup.
# In the dashboard, choose the matching role and paste only its key VALUE.
# Multiple roles can be connected; credentials remain in memory until page reload.

# Separate emergency-stop credential: never enter this into the dashboard.
# Generate another independent value; do not reuse any role credential.
EMERGENCY_STOP_ADMIN_API_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_32

# Blockchain / Ethereum Sepolia Configuration
CHAIN_ID=11155111

# Sepolia RPC URL:
# For local simulation / testing without testnet funds, keep:
#   SEPOLIA_RPC_URL=https://mock-rpc.sepolia.org
# For live Sepolia broadcasting, provide an Infura, Alchemy, or PublicNode RPC URL:
#   SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
SEPOLIA_RPC_URL=https://mock-rpc.sepolia.org

# Runtime transaction signer private key (64 hex characters without 0x prefix).
# This is the only private key consumed by backend/app/services/signer.py.
# It signs authorized native ETH transactions; it is not a deployer or relayer key.
# WARNING: Dedicated testnet account ONLY. NEVER use a mainnet key or real funds.
# Generate a fresh testnet burner yourself with:
#   python -c "from eth_account import Account; a = Account.create(); print(a.key.hex().removeprefix('0x'))"
SIGNER_PRIVATE_KEY=CHANGE_ME_TESTNET_ONLY_BURNER_PRIVATE_KEY

# Deployment and contract-integration variables
# The current backend has no deployment script, relayer service, contract ABI,
# or contract-address lookup. These variables are intentionally commented out
# and are NOT required for backend startup or the current native-ETH flow.
#
# DEPLOYER_PRIVATE_KEY             Deployment-only account, if added later.
# RELAYER_PRIVATE_KEY              Relayer-only account, if added later.
# RELAYER_ADDRESS                  Must be derived/checked by a future relayer.
# AUTHORIZED_SIGNER_PRIVATE_KEY    Not read by the current backend.
# AUTHORIZED_SIGNER_ADDRESS        Not read or validated by the current backend.
# KITESHIELD_WALLET_ADDRESS       Not read by the current backend.
# KITESHIELD_CONTRACT_ADDRESS     Not read by the current backend.
# Do not copy SIGNER_PRIVATE_KEY into any of these roles.

# Optional: OpenAI API for natural language agent proposals
# If left empty, fallback deterministic regex parsing handles structured transfers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Required live prompt-injection ensemble configuration.
# Models are loaded from the local Hugging Face/package cache only by default.
AI_ML_HORIZON_MODEL_ID=Horizon-Labs/prompt-injection-guard-base
AI_ML_BASTION_MODEL_ID=bastionsoft/binary-bastion-prompt-protection-deberta-v3-xsmall-v1
# Horizon uses argmax by default. Use threshold only after selecting and recording
# a verified development-set threshold.
AI_ML_HORIZON_CLASSIFICATION_METHOD=argmax
AI_ML_HORIZON_THRESHOLD=0.5
AI_ML_BASTION_THRESHOLD=0.059
AI_ML_DEVICE=cpu
AI_ML_LOCAL_FILES_ONLY=true
AI_ML_INFERENCE_TIMEOUT_SECONDS=30
AI_ML_MAX_PROMPT_LENGTH=2000

# Security Parameters
CAPABILITY_TOKEN_TTL_SECONDS=120
APPROVAL_EXPIRY_SECONDS=900
CLOCK_SKEW_SECONDS=30
# Safe default: signed test transactions are simulated, never sent to RPC.
EXECUTION_MODE=simulated
# Optional research gate, not required for the normal payment workflow.
LEARNED_SCREENING_ENABLED=false
MAX_GAS_UNITS=100000
MAX_FEE_PER_GAS_WEI=100000000000
MAX_PRIORITY_FEE_PER_GAS_WEI=2000000000
# Autonomous execution is opt-in; only verified live Sepolia is eligible.
AUTO_EXECUTE_ENABLED=false
AUTO_EXECUTE_MAX_ETH=0.0001
# Treasury monitor is separately opt-in. Existing live .env is never changed by setup.
# New mandates are saved disabled and first enabled in plan-only mode.
TREASURY_MONITOR_ENABLED=false
TREASURY_MONITOR_INTERVAL_SECONDS=60
TREASURY_CLAIM_SECONDS=120
# Read-only portfolio: JSON public-address list, and explicitly configured tokens only.
WATCHED_ADDRESSES=[]
TOKEN_ALLOWLIST=[]
# TOKEN_ALLOWLIST=[{"symbol":"TEST","address":"0x1111111111111111111111111111111111111111","decimals":18}]

# Draft-only mandate interpretation; no saving, activation or execution.
DRAFTER_LLM_ENABLED=false
DRAFTER_LLM_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
DRAFTER_LLM_MODEL=kiteshield-gemma4:12b-q4km
DRAFTER_LLM_TIMEOUT_SECONDS=5
DRAFTER_RECIPIENT_ALIASES={}
# Accounts payable: opt-in, disabled by default. Model destination is fixed loopback.
INVOICE_INTAKE_ENABLED=false
INVOICE_AUTO_EXECUTE_ENABLED=false
# Separate explicit authorization is required before enabling this in live Sepolia.
INVOICE_LIVE_EXECUTION_ENABLED=false
INVOICE_INBOX=./invoice-inbox
INVOICE_POLL_SECONDS=15
INVOICE_MODEL=kiteshield-gemma4:12b-q4km
INVOICE_MAX_FUTURE_DAYS=90
INVOICE_MAX_OVERDUE_DAYS=30
# Learned screening cannot be used for invoices without a separately evaluated profile.
INVOICE_LEARNED_EVALUATED=false
# Invoice-specific Horizon + Bastion gate; does not enable learned screening on
# the normal proposal path. Both must clear; disagreement/failure requires review.
INVOICE_LEARNED_SCREENING_ENABLED=true
# Configure aliases with public, already-allowlisted addresses in an isolated profile.

# Incoming testnet ETH faucet (Coinbase CDP). Never put these in VITE_* or prompts.
# Default: disabled. Simulation never calls the faucet and never claims funding.
FAUCET_ENABLED=false
FAUCET_MODE=simulated
FAUCET_MAX_REQUESTS_24H=3
# Obtain a CDP Secret API key; this is NOT your Ethereum private key.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Real requests require FAUCET_MODE=sepolia and EXECUTION_MODE=sepolia.
# Targets are restricted to the signer public address and WATCHED_ADDRESSES.

# Voice/file commands search only these explicit directories (one level, no symlinks).
# Empty list uses INVOICE_INBOX. Never put your home directory here.
INVOICE_SEARCH_ROOTS=[]
INVOICE_AGENT_BATCH_LIMIT=3

# Main live entry point: python -m scripts.run_main_live (Sepolia only).
# Enabling AUTO_EXECUTE_ENABLED plus invoice execution flags permits real test-ETH
# transfers from explicit commands and authorized watched-folder duties.
# Examples above remain disabled by default; normal role credentials are required.

# Optional local voice, incoming observer and guarded vault (all off by default)
LOCAL_VOICE_ENABLED=false
LOCAL_VOICE_BINARY=
LOCAL_VOICE_BINARY_SHA256=
LOCAL_VOICE_MODEL=
LOCAL_VOICE_MODEL_SHA256=
LOCAL_VOICE_MAX_SECONDS=20
LOCAL_VOICE_TIMEOUT_SECONDS=30
AUTONOMY_INCOMING_WATCH_ENABLED=false
AUTONOMY_INCOMING_POLL_SECONDS=30
AUTONOMY_INCOMING_CONFIRMATIONS=6
VAULT_ENABLED=false
AUTONOMY_VAULT_PAYMENTS_ENABLED=false
VAULT_QUARANTINE_PAUSE_ENABLED=false
VAULT_AGENT_KEY_FILE=
VAULT_AGENT_ADDRESS=
VAULT_ARTIFACT_SHA256=
VAULT_MAX_GAS_UNITS=1000000
VAULT_OWNER_MAX_GAS_UNITS=8000000
VAULT_FEE_BUDGET_WEI=0
VAULT_ESCROW_BUDGET_WEI=0
VAULT_AGENT_GAS_BUDGET_WEI=0
VAULT_SESSION_TTL_SECONDS=3600

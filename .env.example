# ====================
# KiteShield Wallet — Environment Configuration
# ====================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ====================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./kiteshield.db

# ---- Security ----
# Secret for signing capability tokens (JWT HS256)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 64 hex chars (32 bytes / 256 bits)
CAPABILITY_TOKEN_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# API key for backend authentication (simple key for MVP)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_32

# ---- Blockchain ----
# Sepolia testnet chain ID (do not change)
CHAIN_ID=11155111

# Sepolia RPC endpoint:
# - For local development/testing without real funds, use:
#   SEPOLIA_RPC_URL=https://mock-rpc.sepolia.org
# - For live Ethereum Sepolia testnet broadcasting, use Alchemy, Infura, or PublicNode:
#   SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_RPC_URL=https://mock-rpc.sepolia.org

# Testnet-only private key (hex, without 0x prefix)
# WARNING: Use a DEDICATED testnet burner wallet. NEVER use a mainnet wallet or real funds.
# Generate with: python -c "from eth_account import Account; a = Account.create(); print(a.key.hex().removeprefix('0x'))"
SIGNER_PRIVATE_KEY=CHANGE_ME_TESTNET_ONLY_PRIVATE_KEY

# ---- OpenAI ----
# API key for agent service
OPENAI_API_KEY=sk-CHANGE_ME_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

# ---- Token Settings ----
# Capability token lifetime in seconds
CAPABILITY_TOKEN_TTL_SECONDS=120

# Approval request expiry in seconds
APPROVAL_EXPIRY_SECONDS=300

# Clock skew tolerance in seconds
CLOCK_SKEW_SECONDS=30

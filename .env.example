# ====================
# KiteShield Wallet — Environment Configuration
# ====================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ====================

# ---- Application ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./kiteshield.db

# ---- Security ----
# Secret for signing capability tokens (JWT HS256)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 64 hex chars (32 bytes / 256 bits)
CAPABILITY_TOKEN_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_HEX_32

# Proposer API key for normal backend authentication.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the generated value in the existing API_KEY entry in backend/.env and
# restart the normal backend. Generating a key does not register it automatically.
# Connect in the dashboard as Proposer using only the key value.
# See backend/.env.example for the separate approver and administrator keys.
#
# Isolated invoice demo: tmp/invoice-demo-server.py ignores .env and uses the
# public Proposer fixture key invoice-lab-proposer-fixture. No generation needed.
# Editing .env does not change that demo key; never use it for a funded profile.
API_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_32

# ---- Blockchain ----
# Sepolia testnet chain ID (do not change)
CHAIN_ID=11155111

# Sepolia RPC endpoint:
# - For local development/testing without real funds, use:
#   SEPOLIA_RPC_URL=https://mock-rpc.sepolia.org
# - For live Ethereum Sepolia testnet broadcasting, use Alchemy, Infura, or PublicNode:
#   SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_RPC_URL=https://mock-rpc.sepolia.org

# Testnet-only private key (hex, without 0x prefix)
# WARNING: Use a DEDICATED testnet burner wallet. NEVER use a mainnet wallet or real funds.
# Generate with: python -c "from eth_account import Account; a = Account.create(); print(a.key.hex().removeprefix('0x'))"
SIGNER_PRIVATE_KEY=CHANGE_ME_TESTNET_ONLY_PRIVATE_KEY

# ---- OpenAI ----
# API key for agent service
OPENAI_API_KEY=sk-CHANGE_ME_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

# ---- Token Settings ----
# Capability token lifetime in seconds
CAPABILITY_TOKEN_TTL_SECONDS=120

# Approval request expiry in seconds
APPROVAL_EXPIRY_SECONDS=300

# Clock skew tolerance in seconds
CLOCK_SKEW_SECONDS=30

# Incoming faucet configuration belongs in backend/.env only; see backend/.env.example.
# FAUCET_ENABLED=false, FAUCET_MODE=simulated; CDP secrets must never be frontend variables.

# Optional local voice, incoming observer and guarded vault (all off by default)
LOCAL_VOICE_ENABLED=false
LOCAL_VOICE_BINARY=
LOCAL_VOICE_BINARY_SHA256=
LOCAL_VOICE_MODEL=
LOCAL_VOICE_MODEL_SHA256=
LOCAL_VOICE_MAX_SECONDS=20
LOCAL_VOICE_TIMEOUT_SECONDS=30
AUTONOMY_INCOMING_WATCH_ENABLED=false
AUTONOMY_INCOMING_POLL_SECONDS=30
AUTONOMY_INCOMING_CONFIRMATIONS=6
VAULT_ENABLED=false
AUTONOMY_VAULT_PAYMENTS_ENABLED=false
# To fund escrow: also register the exact vault in WATCHED_ADDRESSES and set CDP/funding budgets.
AUTONOMY_VAULT_FUNDING_ENABLED=false
VAULT_QUARANTINE_PAUSE_ENABLED=false
VAULT_AGENT_KEY_FILE=
VAULT_AGENT_ADDRESS=
VAULT_ARTIFACT_SHA256=
VAULT_MAX_GAS_UNITS=1000000
VAULT_OWNER_MAX_GAS_UNITS=8000000
VAULT_FEE_BUDGET_WEI=0
VAULT_ESCROW_BUDGET_WEI=0
VAULT_AGENT_GAS_BUDGET_WEI=0
VAULT_SESSION_TTL_SECONDS=3600

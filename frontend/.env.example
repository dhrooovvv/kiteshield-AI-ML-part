# ==========================================
# KiteShield Frontend — Environment Configuration
# ==========================================
# Copy this file to .env:
#   cp .env.example .env
# NEVER commit .env to version control.
# ==========================================

# Backend API Key (matches API_KEY in backend/.env)
VITE_API_KEY=CHANGE_ME_MATCH_BACKEND_API_KEY

# Backend API Base Path (proxied via Vite to http://127.0.0.1:8000 in development)
VITE_API_BASE_URL=/api/v1

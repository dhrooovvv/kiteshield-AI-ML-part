# ==========================================
# KiteShield Frontend — Environment Configuration
# ==========================================
# Copy this file to .env:
#   cp .env.example .env
# NEVER commit .env to version control.
# ==========================================

# API credentials are entered at runtime and kept in memory only.
# Never put API keys, private keys, or emergency-stop credentials in VITE_* variables.

# Backend API Base Path (proxied via Vite to http://127.0.0.1:8000 in development)
VITE_API_BASE_URL=/api/v1
